{
  "name": "@howmp/dsh-pentest",
  "description": "DSH 授权安全测试插件：挖洞模式，以可恢复探索链路记录资产、证据与已验证漏洞；专业安全模式由 SeaOf0/dsh-redteam-model 提供并共存。",
  "version": "0.1.0-rc.36",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "dsh-pentest-repair": "./scripts/repair-composer.mjs",
    "dsh-pentest-burp-mcp": "./scripts/configure-burp-mcp.mjs",
    "dsh-pentest-suite": "./scripts/configure-redteam-suite.mjs"
  },
  "exports": {
    "./burp-mcp": "./scripts/burp-mcp.mjs",
    ".": "./lib/index.js",
    "./pentest": "./lib/pentest.js",
    "./storage-sqlite": "./lib/storage-sqlite.js",
    "./preset-root": "./lib/preset-root.js",
    "./ui-pentest": "./lib/ui-pentest.js",
    "./ui-pentest/client": "./lib/ui-pentest.client.js",
    "./ui-pentest/package.json": "./package.json",
    "./client": "./lib/ui-pentest.client.js",
    "./invariant": "./lib/invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "scripts/repair-composer.mjs",
    "scripts/configure-burp-mcp.mjs",
    "scripts/burp-mcp.mjs",
    "scripts/configure-redteam-suite.mjs",
    "scripts/repair-preset.mjs",
    "preset/**",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "js-yaml": "4.3.1",
    "zod": "^4.4.3"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "scripts": {
    "repair:composer": "node scripts/repair-composer.mjs",
    "configure:burp-mcp": "node scripts/configure-burp-mcp.mjs",
    "configure:suite": "node scripts/configure-redteam-suite.mjs",
    "status:suite": "node scripts/configure-redteam-suite.mjs --status",
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build.mjs --target host",
    "build:client": "node scripts/build.mjs --target client",
    "build:check": "node scripts/build.mjs --check",
    "deps:check": "node scripts/check-deps.mjs",
    "test": "vitest run",
    "test:bundle": "vitest run tests/bundle.spec.ts",
    "test:host": "vitest run src/dsh-pentest/tests"
  },
  "devDependencies": {
    "js-yaml": "4.3.1",
    "jsdom": "^26.1.0",
    "vitest": "4.1.8"
  }
}
